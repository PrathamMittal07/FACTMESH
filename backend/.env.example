# FactMesh - Environment Variables
# Copy this file to .env and fill in real values

# Google Gemini API key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model (gemini-3.6-flash = fast+cheap, gemini-1.5-pro = highest quality)
GEMINI_MODEL=gemini-3.6-flash

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://factmesh:factmesh@localhost:5432/factmesh

# Embedding model (local sentence-transformers, no API key needed)
EMBEDDING_MODEL=all-mpnet-base-v2

# Similarity search tuning (adjust after Phase 5 testing)
SIMILARITY_THRESHOLD=0.65
SIMILARITY_K=10

# Confidence thresholds for extraction quality
CONFIDENCE_FLAG_THRESHOLD=0.6
CONFIDENCE_REJECT_THRESHOLD=0.3

# LLM quota pacing (free-tier Gemini keys are rate-limited)
LLM_BATCH_DELAY_SEC=4.0
LLM_MAX_RETRIES=6
LLM_RETRY_BASE_SEC=10.0
